# ─── Solana ───────────────────────────────────────────────────────────────────
VITE_SOLANA_NETWORK=devnet
VITE_RPC_URL=https://api.devnet.solana.com

# ─── Firebase ─────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Backend API ──────────────────────────────────────────────────────────────
# Leave EMPTY (or omit) for local dev with Vite proxy (vite.config.ts proxies /api → localhost:5000)
# Set to your Render/Railway backend URL for production builds
VITE_API_URL=https://stealthpay-backend.onrender.com
