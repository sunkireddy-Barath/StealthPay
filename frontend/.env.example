# Backend API
# In dev, leave blank to use the Vite proxy at /api -> http://localhost:5000.
# In prod, set to the deployed backend, e.g. https://stealthpay-backend.onrender.com
VITE_API_URL=

# Solana
VITE_SOLANA_NETWORK=devnet
VITE_RPC_URL=https://api.devnet.solana.com

# Firebase (optional — Google sign-in is disabled if unset)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Supabase (optional — used by the frontend Supabase client if present)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
