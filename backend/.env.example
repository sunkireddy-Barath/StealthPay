# Flask
FLASK_ENV=development
FLASK_DEBUG=true

# Required in production. Tokens become forgeable if this is missing.
JWT_SECRET_KEY=replace-with-a-long-random-string

# Database (defaults to SQLite if unset)
DATABASE_URL=postgresql://postgres:password@localhost:5432/stealthpay

# Comma-separated list of allowed origins for /api/*; * for permissive
CORS_ORIGINS=http://localhost:5173

# Public-facing base URL for generated payment-link/invoice URLs.
# Leave blank to emit relative paths.
PUBLIC_BASE_URL=http://localhost:5173

# Supabase (optional — sync is skipped when unset)
SUPABASE_URL=
SUPABASE_KEY=
